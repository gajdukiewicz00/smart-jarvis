# SmartJARVIS Environment Variables
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL=postgresql://jarvis:jarvis_secret_2024@localhost:5432/smartjarvis
MONGODB_URL=mongodb://jarvis_app:jarvis_app_secret_2024@localhost:27017/smartjarvis

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Redis Configuration
REDIS_URL=redis://:jarvis_redis_2024@localhost:6379

# Service Ports
API_GATEWAY_PORT=8080
VOICE_GATEWAY_PORT=8081
STT_SERVICE_PORT=8082
NLU_SERVICE_PORT=8083
DM_SERVICE_PORT=8084
TTS_SERVICE_PORT=8085
TODO_SERVICE_PORT=8086
CALENDAR_SERVICE_PORT=8087
MONEY_SERVICE_PORT=8088
MEMORY_SERVICE_PORT=8089
DEVICE_AGENT_PORT=8090
HOME_BRIDGE_PORT=8091

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# External Services
OPENAI_API_KEY=your-openai-api-key
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region

# Home Assistant
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your-home-assistant-token

# Development
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
DEBUG=false
